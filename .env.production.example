# Production/staging template. Copy to .env.production or inject the same keys
# from your secret manager/platform environment.

NODE_ENV=production

# Public domains used by Caddy and browser clients.
API_HOST=api.example.com
STUDENT_HOST=student.example.com
ADMIN_HOST=admin.example.com
PORTAL_HOST=portal.example.com
COURSES_HOST=courses.example.com
CADDY_ACME_EMAIL=ops@example.com
CADDY_MAX_BODY_SIZE=500MB

# API URLs and browser-reachable portal URLs.
APP_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_WEB_STUDENT_URL=https://student.example.com
NEXT_PUBLIC_WEB_SALES_URL=https://courses.example.com
CORS_ORIGINS=https://student.example.com,https://admin.example.com,https://portal.example.com,https://courses.example.com

# Database and Redis.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password-at-least-32-characters
POSTGRES_DB=lms_platform
DATABASE_URL=postgresql://postgres:change-me-postgres-password-at-least-32-characters@postgres:5432/lms_platform
REDIS_URL=redis://redis:6379

# Auth and cookies.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_RESET_SECRET=change-me-reset-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=.example.com
TRUST_PROXY=true
ALLOW_TENANT_HEADER_IN_PRODUCTION=false

# Google Identity Services. Leave blank if disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI provider. Keep off until backend-only provider keys are configured.
AI_PROVIDER=off
AI_ENDPOINT_URL=https://ai-gateway.example.com/evaluate
AI_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=512
AI_TEMPERATURE=0.2

# Mail provider. Leave disabled until SMTP credentials are configured.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=LMS Platform <noreply@example.com>

# Monitoring.
ALERTMANAGER_WEBHOOK_URL=https://alerts.example.com/lms-platform

# Optional MCP integration. Keep disabled unless explicitly needed.
MCP_ENABLED=false
MCP_API_KEY=
MCP_ALLOW_QUERY_API_KEY=false
MCP_PROJECT_ROOT=
MCP_TENANT_ID=
